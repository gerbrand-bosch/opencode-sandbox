# OpenCode Configuration
#
# Web interface settings
OPENCODE_WEB_PASSWORD=
OPENCODE_API_KEY=

# Network settings
OPENCODE_HOST=0.0.0.0
OPENCODE_PORT=3000

# Data persistence
DATA_VOLUME=./data
CONFIG_VOLUME=./config

# Enable additional features
ENABLE_PDF_TOOLS=true
ENABLE_IMAGE_PROCESSING=true
ENABLE_OCR=true